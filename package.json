{
  "name": "ai-accessibility-automation-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cost-aware accessibility crawler with axe-core triage, conditional vision checks, evidence screenshots, crawl graph, and VPAT/ACR exports.",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "scan": "node src/cli.js",
    "journey": "node scripts/run-journey.js",
    "scan:android": "node scripts/scan-android.js",
    "sessions:migrate": "node scripts/migrate-sessions.js",
    "reports:prune": "node scripts/prune-reports.js",
    "install:browsers": "playwright install chromium",
    "install:nvda-addon": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-nvda-addon.ps1",
    "test": "node --test",
    "test:architecture": "node --test test/architecture.test.js test/api-assembly.test.js test/engine-modules.test.js",
    "test:openapi": "node --test test/openapi.test.js",
    "test:browser": "node scripts/run-browser-fixtures.js",
    "test:review-fixes": "node scripts/verify-review-fixes.js",
    "test:nvda-addon": "python -I scripts/verify-nvda-addon.py",
    "test:auth": "node scripts/verify-auth-flow.js",
    "test:auth-auto": "node scripts/verify-automatic-auth-flow.js",
    "test:auth-ai": "node scripts/verify-ai-auth-flow.js",
    "test:report-tabs": "node scripts/verify-report-tabs.js",
    "test:report-comparison": "node scripts/verify-report-comparison.js",
    "test:dashboard-score": "node scripts/verify-dashboard-score.js",
    "test:dashboard-refresh": "node scripts/verify-dashboard-refresh.js",
    "test:crawl-actions": "node scripts/verify-crawl-actions.js",
    "test:interaction-crawl": "node scripts/verify-interaction-crawl.js",
    "test:crawl-limits": "node scripts/verify-crawl-limits.js",
    "test:tab-switching": "node scripts/verify-tab-switching.js",
    "test:action-exclusions": "node scripts/verify-action-exclusions.js",
    "test:native-browser-windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-native-browser-windows.ps1",
    "test:action-login-gate": "node scripts/verify-action-login-gate.js",
    "test:live-status": "node scripts/verify-live-status.js",
    "test:ai-grounding": "node scripts/verify-ai-grounding.js",
    "test:ai-grounding-crawl": "node scripts/verify-ai-grounding-crawl.js",
    "test:post-login": "node scripts/verify-post-login-setup.js",
    "test:navigation-race": "node scripts/verify-navigation-race.js",
    "test:needs-review": "node scripts/verify-needs-review-evidence.js",
    "test:protected-spa": "node scripts/verify-protected-spa-replay.js",
    "test:blocker-recovery": "node scripts/verify-blocker-recovery.js",
    "test:screen-reader-readiness": "node scripts/verify-screen-reader-readiness.js",
    "test:nvda-integration": "node --test test/nvda.test.js",
    "test:required-fields": "node scripts/verify-required-fields.js",
    "test:nvda-state-replay": "node scripts/verify-nvda-state-replay.js",
    "test:nvda-browser-filter": "node scripts/verify-nvda-browser-filter.js",
    "test:live-nvda-crawl": "node scripts/verify-live-nvda-crawl.js",
    "test:nvda-after-crawl": "node scripts/verify-nvda-after-crawl.js",
    "test:nvda-live-browser": "node scripts/verify-nvda-live-browser.js",
    "test:nvda-reading": "node scripts/verify-nvda-reading.js",
    "test:nvda-live-crawl-browser": "node scripts/verify-nvda-live-crawl-browser.js",
    "test:audit-workflow": "node scripts/verify-audit-workflow.js",
    "test:financial-workflow": "node scripts/verify-financial-workflow.js",
    "test:keyboard": "node scripts/verify-keyboard-checks.js",
    "test:adaptation-media": "node scripts/verify-adaptation-media.js",
    "test:documents": "node scripts/verify-documents.js",
    "test:remediation": "node scripts/verify-remediation.js",
    "test:vpat": "node scripts/verify-vpat.js",
    "test:journeys": "node scripts/verify-journeys.js",
    "test:compliance": "node scripts/verify-compliance.js",
    "test:mobile": "node scripts/verify-mobile.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.10.2",
    "axe-core": "^4.10.2",
    "docx": "9.11.0",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "openai": "^4.86.1",
    "pdfjs-dist": "6.4.299",
    "playwright": "^1.51.1"
  }
}
