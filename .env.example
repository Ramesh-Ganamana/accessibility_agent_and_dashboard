# Server
PORT=4173

# Optional target defaults
TARGET_URL=http://localhost:3000
MAX_PAGES=25
# Separate total page/interaction-state cap; MAX_PAGES=1 can still explore controls.
MAX_STATES=100
MAX_DEPTH=3
HEADLESS=true
# Use Playwright's bundled Chromium engine.
# Accepted values: bundled, chrome, msedge, auto
BROWSER_CHANNEL=bundled
# Maximum wait for an application shell that renders after load (ms, 0-600000).
APP_SHELL_WAIT_MS=90000
# Ads, video, chat and CAPTCHA frames from other sites are skipped and listed in
# the report limitations. Set true to scan embedded third-party frames as well.
SCAN_THIRD_PARTY_FRAMES=false
# Certificate errors are ignored only when no credentials are typed. Set true
# for a trusted QA host with a self-signed certificate.
IGNORE_HTTPS_ERRORS=
# Saved login sessions contain live cookies and are stored per user outside the
# project (default %LOCALAPPDATA%\RAMBO\sessions), encrypted with Windows DPAPI.
# Convert plain sessions from older versions with: npm run sessions:migrate
AUTH_STATE_DIR=
# desktop (1440x960) or mobile (Pixel 7 emulation with touch; not a real device).
SCAN_DEVICE=desktop
# Tab presses per page for the keyboard checks (10-500).
KEYBOARD_MAX_TABS=120
# Same-site PDFs downloaded and checked per scan (0 turns document checks off).
DOCUMENTS_MAX=10
# Extra hostnames the dashboard may be opened from (it otherwise accepts only
# localhost, 127.0.0.1 and [::1] to block DNS-rebinding attacks).
DASHBOARD_ALLOWED_HOSTS=

# Optional actual NVDA website test. Selected scans use the same maximized,
# headed crawl browser on an unlocked interactive Windows desktop. Without NVDA,
# HEADLESS continues to control the normal crawl.
NVDA_ENABLED=false
# during-crawl (default): scan a state, wait for its NVDA checks, then move on.
# after-crawl is optional replay mode; states may not be reproducible in a new tab.
NVDA_MODE=during-crawl
NVDA_PATH=
NVDA_CONFIG_PATH=
# NVDA tests captured UI states, including multiple states at the same URL.
NVDA_MAX_STATES=100
NVDA_TAB_STOPS=12
NVDA_TESTS=focus,reading,headings,tables
# Read to the end of available browse content; safety cap per state (up to 1800000).
# Timeouts are partial, never treated as completed reading.
NVDA_READING_TIMEOUT_MS=300000
NVDA_HEADING_STOPS=3
NVDA_TABLE_STOPS=3
# Maximum connection deadline, not a fixed sleep: proceed immediately when ready.
NVDA_STARTUP_TIMEOUT_MS=60000
NVDA_ANNOUNCEMENT_WAIT_MS=650
# Stop waiting this long (ms) after a key when NVDA says nothing at all.
# 0 keeps the full wait (about 2 s). Check firstSpeechMs in a real run first.
NVDA_SILENT_WAIT_MS=0
# Pause after each native key; speech capture waits separately.
NVDA_KEY_DELAY_MS=100
# Comfortable speech for listeners; 0..100 is NVDA's rate scale.
NVDA_FAST_SPEECH=false
NVDA_SPEECH_RATE=40
# review = screenshot only stops that need review; all = every keyboard stop.
NVDA_ACTION_SCREENSHOTS=review

# Authentication (optional; prefer AUTH_SETUP_URL + interactive npm run auth)
LOGIN_URL=
LOGIN_EMAIL=
LOGIN_PASSWORD=
EMAIL_SELECTOR=#signInName, input[type="email"], input[name="email"], input[name="username"], input[autocomplete="username"]
PASSWORD_SELECTOR=input[type="password"], input[autocomplete="current-password"]
SUBMIT_SELECTOR=#continue, #next, #signIn, button[type="submit"], input[type="submit"]
POST_LOGIN_VALUE=

# AI checks send screenshots and sanitized page metadata to OpenAI. They run only
# when explicitly enabled: per scan in the dashboard, `npm run scan -- <url> --ai`,
# or AI_ENABLED=true here. An API key alone never enables them.
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Numbered-element AI navigation starts only after this no-progress interval.
AI_CRAWLER_STALL_MS=5000

# Comma-separated route fragments that should not be crawled.
EXCLUDE_PATHS=/logout,/signout,/delete,/remove
# Optional exact visible control labels to skip, separated by commas.
EXCLUDE_ACTION_LABELS=
